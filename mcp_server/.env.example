# Copy this file to mcp_server/.env and fill in real values. Never commit the
# real .env (see ../.gitignore) -- same discipline this project already
# applies to .streamlit/secrets.toml.
#
# Use a PROD-pointed Turso credential here, not the dev branch this repo's own
# local .streamlit/secrets.toml points at -- see docs/ROADMAP.md's V4.13
# section for why. Recommended: mint a credential dedicated to this VPS rather
# than reusing Streamlit Community Cloud's own token, same isolation principle
# already used for each Hermes bot's own Google Cloud project.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
